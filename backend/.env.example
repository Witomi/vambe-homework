PORT=3001
# Orígenes permitidos por CORS (separados por coma)
FRONTEND_URL=http://localhost:3000

# Datos
DATA_DIR=data
CLIENTS_CSV=clients.csv
CATEGORIZATIONS_FILE=categorizations.json

# LLM (Gemma vía Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
LLM_MODEL=gemma-4-26b-a4b-it
LLM_FALLBACK_MODEL=gemma-4-31b-it
LLM_THINKING_LEVEL=minimal
LLM_TIMEOUT_MS=180000
LLM_RPM=25
LLM_TEMPERATURE=0.1
